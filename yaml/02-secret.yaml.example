# Example only. Do NOT apply this file as-is or commit real credentials.
# Create the postgres-secret resource locally using:
# kubectl create secret generic postgres-secret --from-env-file=k8s-secret.env
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
type: Opaque
stringData:
  POSTGRES_USER: moviesuser
  POSTGRES_PASSWORD: REPLACE_WITH_YOUR_LOCAL_PASSWORD
